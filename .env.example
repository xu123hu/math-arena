# ==================== Math Arena 开发环境变量 ====================
# 复制此文件为 .env 并填入实际值
# cp .env.example .env

# -------------------- 数据库 --------------------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/math_arena

# -------------------- Redis --------------------
REDIS_URL=redis://localhost:6379/0

# -------------------- 星火大模型（主通道） --------------------
# 注意：必须使用 HTTP 协议，禁止 WebSocket SDK
# 临时方案：可填入 DeepSeek API Key 作为星火通道的替代
SPARK_API_PASSWORD=your_spark_api_password_here
SPARK_MODEL=spark-ultra

# -------------------- DeepSeek（备用通道） --------------------
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-v4-flash
# 聊天场景默认关闭思考模式（ADR-001-8）
DEEPSEEK_THINKING=false

# -------------------- Embedding / Reranker --------------------
EMBEDDING_BASE_URL=http://localhost:8080
RERANKER_BASE_URL=http://localhost:8081

# -------------------- JWT --------------------
JWT_SECRET=change-me-to-a-random-secret-in-production

# -------------------- 应用 --------------------
# 前端 VITE 环境变量（前端使用）
VITE_API_BASE=http://localhost:8000/api

# 短信验证码（开发环境固定 123456）
DEV_SMS_CODE=123456

# -------------------- 统一认证与身份治理 --------------------
APP_ENV=development
AUTH_ACCESS_TOKEN_MINUTES=15
AUTH_ALLOW_LEGACY_TOKENS=true
AUTH_STANDARD_ABSOLUTE_HOURS=168
AUTH_STANDARD_IDLE_MINUTES=1440
AUTH_REMEMBER_ABSOLUTE_HOURS=720
AUTH_REMEMBER_IDLE_MINUTES=10080
AUTH_ADMIN_ABSOLUTE_HOURS=12
AUTH_ADMIN_IDLE_MINUTES=30

# development 可使用 demo；staging/production 必须配置 tencent 等真实 provider
AUTH_SMS_PROVIDER=demo
AUTH_DEMO_SMS_ALLOWLIST=13800000000
AUTH_OTP_PEPPER=replace-with-random-secret
AUTH_REFRESH_TOKEN_PEPPER=replace-with-different-random-secret
AUTH_INVITE_PEPPER=replace-with-third-random-secret
TENCENT_SMS_SECRET_ID=
TENCENT_SMS_SECRET_KEY=
TENCENT_SMS_SDK_APP_ID=
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_TEMPLATE_ID=
# 腾讯云控制台区域，例如 ap-guangzhou；凭证仅通过部署 secret 注入，禁止填写真实值。
TENCENT_SMS_REGION=ap-guangzhou
# JSON 字符串数组；{code} 会替换为一次性验证码，须与已审核模板参数顺序一致。
TENCENT_SMS_TEMPLATE_PARAMS=["{code}"]

# 可信代理与异常登录 CAPTCHA 适配器；未配置时不得在生产静默降级
AUTH_TRUSTED_PROXIES=127.0.0.1/32
AUTH_CAPTCHA_PROVIDER=disabled
ADMIN_PHONES=

# 仅受信运维容器临时开启；secret 通过部署 secret 注入，禁止写入本文件实际值
AUTH_BREAK_GLASS_ENABLED=false
AUTH_TRUSTED_OPERATIONS_ENV=false
AUTH_BREAK_GLASS_SECRET=
