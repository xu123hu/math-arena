# ==================== Math Arena 开发环境变量 ====================
# 复制此文件为 .env 并填入实际值
# cp .env.example .env

# -------------------- 数据库 --------------------
# 注意端口是 54329：deploy/docker-compose.yml 将 postgres 容器 5432 映射到宿主 54329，避免与本地 PG 冲突
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:54329/math_arena

# -------------------- Redis --------------------
REDIS_URL=redis://localhost:6379/0

# -------------------- 星火大模型（主通道） --------------------
# 注意：必须使用 HTTP 协议，禁止 WebSocket SDK
# 临时方案：可填入 DeepSeek API Key 作为星火通道的替代
SPARK_API_PASSWORD=your_spark_api_password_here
SPARK_MODEL=spark-ultra
# 思考模式全局默认（默认关，per-call thinking=True 可覆盖）
SPARK_THINKING=false

# -------------------- DeepSeek（备用通道） --------------------
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-v4-flash
# 聊天场景默认关闭思考模式（ADR-001-8）
DEEPSEEK_THINKING=false
DEEPSEEK_BASE_URL=https://api.xiaomimimo.com/v1/chat/completions

# -------------------- Embedding / Reranker --------------------
EMBEDDING_BASE_URL=http://localhost:8080
RERANKER_BASE_URL=http://localhost:8081
# embedding 提供方：local（本地服务）/ 远程 OpenAI 兼容服务
EMBEDDING_PROVIDER=local
EMBEDDING_API_KEY=
EMBEDDING_MODEL=bge-m3

# -------------------- RAG 阈值 --------------------
RAG_TRGM_THRESHOLD=0.08
RAG_RAW_THRESHOLD=0.15
RAG_REFUSE_THRESHOLD=0.35

# -------------------- 云知识库（管理后台可热更新，env 为兜底层） --------------------
CLOUD_KB_ENABLED=false
# tencent_lkeap / aliyun_bailian / 空=未配置
CLOUD_KB_PROVIDER=
# JSON 兜底：provider 专属凭证，如 {"credentials":{"secret_id":"..."},"knowledge_base_id":"..."}
CLOUD_KB_CONFIG={}
CLOUD_KB_TOP_K=5
CLOUD_KB_SCORE_THRESHOLD=0.5

# -------------------- JWT --------------------
JWT_SECRET=change-me-to-a-random-secret-in-production

# -------------------- 应用 --------------------
APP_ENV=development
# CORS 白名单（逗号分隔）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 前端 VITE 环境变量（前端使用）
VITE_API_BASE=http://localhost:8000/api

# 短信验证码（开发环境固定 123456）
DEV_SMS_CODE=123456

# -------------------- 统一认证与身份治理 --------------------
AUTH_ACCESS_TOKEN_MINUTES=15
AUTH_ALLOW_LEGACY_TOKENS=true
AUTH_STANDARD_ABSOLUTE_HOURS=168
AUTH_STANDARD_IDLE_MINUTES=1440
AUTH_REMEMBER_ABSOLUTE_HOURS=720
AUTH_REMEMBER_IDLE_MINUTES=10080
AUTH_ADMIN_ABSOLUTE_HOURS=12
AUTH_ADMIN_IDLE_MINUTES=30

# development 可使用 demo；staging/production 必须配置 tencent 等真实 provider
AUTH_SMS_PROVIDER=demo
# 比赛演示：教师/科研人员验证手机号后直接开通；设为 true 才恢复管理员审核。
AUTH_PROFESSIONAL_REVIEW_ENABLED=false
# 演示短信白名单：留空 = 开发环境任意手机号均可走演示通道；填写则仅放行名单内号码（逗号分隔）
AUTH_DEMO_SMS_ALLOWLIST=
AUTH_OTP_PEPPER=replace-with-random-secret
AUTH_REFRESH_TOKEN_PEPPER=replace-with-different-random-secret
AUTH_INVITE_PEPPER=replace-with-third-random-secret
TENCENT_SMS_SECRET_ID=
TENCENT_SMS_SECRET_KEY=
TENCENT_SMS_SDK_APP_ID=
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_TEMPLATE_ID=
# 腾讯云控制台区域，例如 ap-guangzhou；凭证仅通过部署 secret 注入，禁止填写真实值。
TENCENT_SMS_REGION=ap-guangzhou
# JSON 字符串数组；{code} 会替换为一次性验证码，须与已审核模板参数顺序一致。
TENCENT_SMS_TEMPLATE_PARAMS=["{code}"]

# 可信代理与异常登录 CAPTCHA 适配器；未配置时不得在生产静默降级
AUTH_TRUSTED_PROXIES=127.0.0.1/32
AUTH_CAPTCHA_PROVIDER=disabled

# 仅受信运维容器临时开启；secret 通过部署 secret 注入，禁止写入本文件实际值
AUTH_BREAK_GLASS_ENABLED=false
AUTH_TRUSTED_OPERATIONS_ENV=false
AUTH_BREAK_GLASS_SECRET=

# -------------------- 管理后台 --------------------
# 逗号分隔手机号；验证码登录命中且无 admin 绑定时自动绑定 admin 角色
ADMIN_PHONES=

# -------------------- 对象存储（M2，ADR-M2B-001：cos/oss/minio/s3_custom，支持自定义端口） --------------------
# 本地开发直连 deploy/docker-compose.yml 的 MinIO（docker compose up 后需建一次桶 math-arena）：
#   STORAGE_PROVIDER=minio
#   STORAGE_ENDPOINT_URL=http://127.0.0.1:9000
#   STORAGE_BUCKET=math-arena
#   STORAGE_ACCESS_KEY=minioadmin
#   STORAGE_SECRET_KEY=minioadmin123
# 生产/云存储改 STORAGE_PROVIDER=cos|oss 并填对应凭证
STORAGE_PROVIDER=cos
STORAGE_SCHEME=https
STORAGE_HOST=
STORAGE_PORT=
STORAGE_ENDPOINT_URL=
STORAGE_REGION=ap-guangzhou
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_SESSION_TOKEN=
STORAGE_PRESIGN_EXPIRES=900

# -------------------- 星辰工作流（M2，ADR-M2B-004：全配置化可移植） --------------------
XINGCHEN_ENABLED=false
XINGCHEN_BASE_URL=https://xingchen-api.xf-yun.com
XINGCHEN_API_KEY=
XINGCHEN_API_SECRET=
# JSON：flow 注册名 -> flow_id，如 {"wf_doc_understand":"7xxx","wf_speech_to_latex":"7xxx"}
XINGCHEN_FLOW_IDS={}
# JSON：flow 注册名 -> read 超时秒（缺省用注册表默认）
XINGCHEN_TIMEOUTS={}
XINGCHEN_MAX_CONCURRENCY=3
XINGCHEN_QUEUE_MAX=10
XINGCHEN_DAILY_ALERT_THRESHOLD=1200

# -------------------- 讯飞语音（M2） --------------------
XFYUN_APP_ID=
XFYUN_API_KEY=
XFYUN_API_SECRET=
XFYUN_LFASR_SECRET_KEY=
XFYUN_IAT_BASE_URL=https://iat-api.xfyun.cn/v2/iat
XFYUN_LFASR_BASE_URL=https://raasr.xfyun.cn/v2/api

# -------------------- 联网搜索试点（M2，默认关闭） --------------------
WEB_SEARCH_ENABLED=false

# -------------------- SymPy 沙箱（M2） --------------------
SANDBOX_TIMEOUT_MS=10000
SANDBOX_MEM_LIMIT_MB=256
SANDBOX_CPU_LIMIT_S=10

# -------------------- 服务间工具密钥（M2，/tools/* 与运维端点） --------------------
TOOL_API_KEY=

# -------------------- 并发与限流（M2，A9 配置化） --------------------
SSE_GLOBAL_CONCURRENCY=20
SSE_USER_CONCURRENCY=3
UPLOAD_RATE_LIMIT_PER_HOUR=10
ASR_TOKEN_RATE_LIMIT_PER_HOUR=20
STUDENT_DAILY_PRACTICE_LIMIT=30
